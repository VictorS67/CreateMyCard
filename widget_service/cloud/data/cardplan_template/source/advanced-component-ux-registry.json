  "layoutComponents": [
    {
      "name": "SingleFocusLayout",
      "description": "单一主内容布局；可在最后一个 child 承载一个布局 Action。2x2 的 IconAction 叠放右下，PillAction 固定底部，业务区不得侵入动作预留区。",
      "supportedCardSizes": ["2x2", "2x4"],
      "minChildren": 1,
      "maxChildrenBySize": {"2x2": 1, "2x4": 1},
      "actionPolicy": "optional",
      "minActionChildrenBySize": {"2x2": 0, "2x4": 0},
      "maxActionChildrenBySize": {"2x2": 1, "2x4": 1},
      "parametersSchema": {
        "type": "object",
        "properties": {
          "contentAlign": {"type": "string", "enum": ["topStart", "centerStart", "bottomStart"]}
        },
        "additionalProperties": false
      },
      "loweringBySize": {"2x2": "column", "2x4": "column"}
    },
    {
      "name": "HeroActionLayout",
      "description": "主业务区加一个必需的布局 Action；Action 必须是最后一个 child。2x2 主业务区使用剩余高度，PillAction 固定底部，短数值与单位横排。",
      "supportedCardSizes": ["2x2", "2x4"],
      "minChildren": 1,
      "maxChildrenBySize": {"2x2": 1, "2x4": 1},
      "actionPolicy": "required",
      "minActionChildrenBySize": {"2x2": 1, "2x4": 1},
      "maxActionChildrenBySize": {"2x2": 1, "2x4": 1},
      "parametersSchema": {
        "type": "object",
        "properties": {
          "actionPlacement": {"type": "string", "enum": ["bottom", "end"]}
        },
        "additionalProperties": false
      },
      "loweringBySize": {"2x2": "column", "2x4": "column"}
    },
    {
      "name": "HeroSupportLayout",
      "description": "主业务区和辅助业务区布局；2x2 纵向，2x4 横向。",
      "supportedCardSizes": ["2x2", "2x4"],
      "minChildren": 2,
      "maxChildrenBySize": {"2x2": 2, "2x4": 2},
      "actionPolicy": "none",
      "minActionChildrenBySize": {"2x2": 0, "2x4": 0},
      "maxActionChildrenBySize": {"2x2": 0, "2x4": 0},
