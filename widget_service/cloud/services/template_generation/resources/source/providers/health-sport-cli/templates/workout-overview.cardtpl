#Template("WorkoutOverview@1", {
  capability: "GetHealthAndSportSummary",
  description: "运动健康数据提供方交付的最近运动概览",
  domainTags: ["workout", "exercise", "training"],
  compatibleThemeProfileIds: ["race-sunrise-action", "race-night-violet"],
  allowedParentComponents: ["Column", "Row", "List", "Stack"],
  bindings: {
    workoutType: { path: "/exerciseTypeName", type: "string" },
    workoutCalories: { path: "/exerciseCalorieText", type: "string" },
    duration: { path: "/exerciseDurationText", type: "string" },
    endTime: { path: "/exerciseEndTimeText", type: "string" }
  },
  params: {
    sourceIcon: { type: "string", kind: "asset", semanticTags: ["sport"] }
  },
  limits: { maxNodes: 16, maxDepth: 4 }
})

#Variant("latest", { sizes: ["2x2", "2x4"], roles: ["hero"], requires: ["workoutType", "workoutCalories", "duration", "endTime"] })
Column("compact", {
  _advancedComponent: "WorkoutOverview", width: "matchParent", height: "matchParent",
  itemMargin: 4, justifyContent: "spaceBetween", alignItems: "start",
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  # Top Section - Title and Calories
  Column("compact", {
    itemMargin: 4, justifyContent: "start", width: "matchParent",
    constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "center", constraintSize: { minWidth: 0, minHeight: 0 } },
      IfParam("sourceIcon",
        Image(Asset("sourceIcon"), "icon", { width: 20, height: 20, objectFit: "contain", flexShrink: 0 })
      ),
      Text(Bind("workoutType"), "subtitle", { width: "matchParent", fontSize: 12, fontWeight: 500, maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
    ),
    Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "bottom", constraintSize: { minWidth: 0, minHeight: 0 } },
      Text(Bind("workoutCalories"), "title", { fontSize: 30, fontWeight: 800, maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } }),
      Text("千卡", "subtitle", { fontSize: 12, fontWeight: 500, maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
    ),
    Progress({ value: 20, total: 100, color: "#FFFFFFFF", backgroundColor: "#1AFFFFFF", strokeWidth: 8, height: 12, width: "matchParent" })
  ),
  # Bottom Section - Exercise Details
  Column("compact", {
    itemMargin: 4, justifyContent: "start", width: "matchParent",
    constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "center", constraintSize: { minWidth: 0, minHeight: 0 } },
      Text(Bind("duration"), "body", { fontSize: 12, maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
    ),
    Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "center", constraintSize: { minWidth: 0, minHeight: 0 } },
      Text(Bind("endTime"), "body", { fontSize: 12, maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
    )
  )
)
#EndVariant
#EndTemplate
