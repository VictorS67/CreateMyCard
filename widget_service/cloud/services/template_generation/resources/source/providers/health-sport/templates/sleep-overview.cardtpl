#Template SleepOverviewFull@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    status: $path("/sleepStatus"),
    score: $path("/sleepScore")
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
        { "itemMargin": 8, "justifyContent": "start", "width": "matchParent" },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
            Text(
                "睡眠情况",
                {
                    "fontSize": 12,
                    "fontWeight": 500,
                    "fontColor": $theme('supportContentColor'),
                    "maxLines": 1
                }
            ),
            IfPresent(
                props.sourceIcon,
                Image(
                    props.sourceIcon,
                    { "width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0 }
                )
            ),
        ),
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom", "margin": {"top": 4} },
            Text(
                data.duration,
                { "fontSize": 24, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        ),
        Progress(
            {
                "value": data.score,
                "total": 100,
                "strokeWidth": 8,
                "color": $theme('supportContentColor'),
                "backgroundColor": "#33564AF7",
                "height": 12,
                "width": "matchParent"
            }
        )
    ),
    Column(
        { "itemMargin": 4, "justifyContent": "start", "width": "matchParent" },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                "睡眠情况评分",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            ),
            Text(
                data.score,
                { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            ),
            Text(
                "分",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            )
        ),
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                data.status,
                {
                    "fontSize": 12,
                    "fontColor": $theme('supportContentColor'),
                    "maxLines": 1,
                    "fontWeight": 400,
                }
            )
        )
    )
)
#End

#Template SleepOverviewHero@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    score: $path("/sleepScore")
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
        { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
        Text(
            "睡眠情况",
            { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
        ),
        IfPresent(
            props.sourceIcon,
            Image(
                props.sourceIcon,
                { "width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0 }
            )
        ),
    ),
    Row(
        { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center", "margin": {"top": 4} },
        Text(
            data.duration,
            { "fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
        )
    ),
    Progress(
        {
            "value": data.score,
            "total": 100,
            "strokeWidth": 8,
            "color": $theme('supportContentColor'),
            "backgroundColor": "#33564AF7",
            "height": 12,
            "width": "matchParent"
        }
    )
)
#End

#Template SleepOverviewCompact@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    score: $path("/sleepScore")
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
        { "itemMargin": 4, "width": "matchParent", "justifyContent": "start", "alignItems": "top" },
        Column(
            {
                "width": "matchParent",
                "itemMargin": 2,
                "justifyContent": "start",
                "alignItems": "start",
                "layoutWeight": 1
            },
            Text(
                data.duration,
                { "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            ),
            Text(
                "睡眠情况时长",
                { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
            ),
        ),
        Stack(
            { "width": 44, "height": 44, "alignContent": "center", "flexShrink": 0 },
            Progress(
                {
                    "value": data.score,
                    "total": 100,
                    "type": "ring",
                    "color": $theme('supportContentColor'),
                    "backgroundColor": "#33564AF7",
                    "width": 44,
                    "height": 44,
                    "strokeWidth": 6
                }
            ),
            IfPresent(
                props.sourceIcon,
                Image(
                    props.sourceIcon,
                    { "width": 20, "height": 20, "objectFit": "contain" }
                )
            )
        )
    )
)
#End

#Template SleepOverviewWideFull@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    status: $path("/sleepStatus"),
    score: $path("/sleepScore"),
    targetDate: $path("/targetDateText")
}

Row(
    {
        "justifyContent": "spaceBetween",
        "_advancedComponent": "SleepOverview",
        "width": "100%",
        "height": "100%",
        "itemMargin": 8,
        "alignItems": "center"
    },
    Column(
        {
            "width": "matchParent",
            "layoutWeight": 1,
            "height": "matchParent",
            "itemMargin": 8,
            "justifyContent": "spaceBetween",
            "alignItems": "start",
            "clip": true,
            "constraintSize": {"minWidth": 0, "minHeight": 0}
        },
        Column(
            {"itemMargin":4,"width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}},
            IfPresent(
                props.sourceIcon,
                Image(
                    props.sourceIcon,
                    {
                        "margin": {"top": 0, "bottom": 2, "left": 0, "right": 0},
                        "width": 24,
                        "height": 24,
                        "objectFit": "contain",
                        "flexShrink": 0
                    }
                )
            ),
            Column(
                {"itemMargin":4,"width": "matchParent", "justifyContent": "start", "alignItems": "start", "clip": true},
                Text(
                    data.duration,
                    {"fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
                ),
                Text(
                    "总睡眠时间",
                    {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
                )
            )
        ),
        Text(
            data.targetDate,
            {"fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
        )
    ),
    Column(
        {
            "width": "matchParent",
            "layoutWeight": 1,
            "itemMargin": 8,
            "clip": true,
            "constraintSize": {"minWidth": 0, "minHeight": 0}
        },
        IfPresent(
            data.score,
            Row(
                {
                    "itemMargin": 4,
                    "padding": {"top": 11, "bottom": 11, "left": 12, "right": 12},
                    "width": "matchParent",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "constraintSize": {"minWidth": 0, "minHeight": 0},
                    "backgroundColor": $theme('actionStyle.backgroundColor'),
                    "borderRadius": 16
                },
                Column(
                    {
                        "itemMargin": 4,
                        "layoutWeight": 1,
                        "width": "matchParent",
                        "justifyContent": "center",
                        "alignItems": "start",
                        "clip": true
                    },
                    Text(
                        data.score,
                        {"fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
                    ),
                    Text(
                        "睡眠分数",
                        {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
                    )
                )
            )
        ),
        IfPresent(
            data.status,
            Row(
                {
                    "itemMargin": 4,
                    "padding": {"top": 11, "bottom": 11, "left": 12, "right": 12},
                    "width": "matchParent",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "constraintSize": {"minWidth": 0, "minHeight": 0},
                    "backgroundColor": $theme('actionStyle.backgroundColor'),
                    "borderRadius": 16
                },
                Column(
                    {
                        "itemMargin": 4,
                        "layoutWeight": 1,
                        "width": "matchParent",
                        "justifyContent": "center",
                        "alignItems": "start",
                        "clip": true
                    },
                    Text(
                        data.status,
                        {"fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
                    ),
                    Text(
                        "睡眠质量",
                        {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
                    )
                )
            )
        )
    )
)
#End
